{
    "name": "afri30/uline",
    "description": "U-Line: AI Online Examination & Dual-Camera Proctoring System with Multi-LLM Subject Tutor & Grounded Database Engine",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Rian Afriyansyah",
            "email": "41256154@stmik-ikmi-cirebon.ac.id",
            "role": "Full-Stack Software Engineer & Student"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "lint": "find app/ -name '*.php' -exec php -l {} \\;"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
