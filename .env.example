# ==============================================================================
# U-Line (AI Online Examination & Proctoring System) Environment Template (.env.example)
# Duplicate this file as .env and adjust credentials to match your server environment
# ==============================================================================

# 1. Application Settings
APP_NAME="AI Online Examination & Proctoring System"
APP_SHORT_NAME="U-Line"
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_URL="http://localhost/uline"
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# 2. Database Connection (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uline_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# 3. Session & Security
SESSION_NAME=uline_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_DOMAIN=""

# 4. AI Provider, Models & Proctoring Assistant Configuration
AI_ENABLED=true
AI_PROVIDER=nvidia

# Primary Provider: NVIDIA NIM (Active Engine)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_FALLBACK_MODEL=google/gemma-3-12b-it
NVIDIA_TEMPERATURE=0.1
NVIDIA_TOP_P=0.7
NVIDIA_MAX_TOKENS=1000
NVIDIA_TIMEOUT=60

# Task-Specific Model Mapping (Modular Assignment)
AI_MODEL_CHAT=meta/llama-3.2-11b-vision-instruct
AI_MODEL_TUTOR=meta/llama-3.2-11b-vision-instruct
AI_MODEL_VISION=meta/llama-3.2-11b-vision-instruct
AI_MODEL_FALLBACK=google/gemma-3-12b-it

# Alternative Provider: Google Gemini (Active when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Alternative Provider: OpenAI (Active when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o

# Alternative Provider: Groq (Active when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# 5. WebRTC Dual Camera & AI Proctoring Settings
PROCTORING_DUAL_CAMERA=true
PROCTORING_HEARTBEAT_INTERVAL=15
PROCTORING_OFFLINE_THRESHOLD=45

# 6. Mail & System Notification
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@uline.test
MAIL_FROM_NAME="U-Line Examination System"

# 7. Exam Token & Security Credentials
EXAM_TOKEN_SECRET_KEY="exam_sec_f98c21a084eb73"

# 8. Fonnte WhatsApp Gateway Configuration
FONNTE_TOKEN=
FONNTE_ENDPOINT="https://api.fonnte.com/send"
FONNTE_TIMEOUT=15
FONNTE_COUNTRY_CODE="62"

# 9. Web Push Notification (Service Worker & VAPID Key Pair)
WEB_PUSH_ENABLED=true
VAPID_PUBLIC_KEY=BBaUatzQ69Pf3irCilU9ZgG5T0kruhWcnrt-FL2ALDacCVbIF5i93RikZ0197KPbq9Ty-vQ0ay5Z9X6ggEaK7Cs
VAPID_PRIVATE_KEY=I0FLkYo2NbAZ_jX4tgEBiM5lzjV9KlRTGs1RpLu-nJ4
VAPID_SUBJECT="mailto:admin@uline.test"


